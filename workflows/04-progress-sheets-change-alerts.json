    {
      "parameters": {
        "jsCode": "const d = $('Build Change Digest').first().json;\nlet summary = '';\ntry { summary = ($input.first().json.text || '').trim(); } catch (e) { summary = ''; }\nconst header = 'Lab sheet changes (' + d.count + ')' + (summary ? '\\n' + summary : '') + '\\n';\nconst MAX = 3800;\nconst chunks = [];\nlet cur = header;\nfor (const b of d.blocks) {\n  let block = b.length > MAX ? b.slice(0, MAX - 20) + '\\n...(truncated)' : b;\n  if ((cur + '\\n\\n' + block).length > MAX) { chunks.push(cur); cur = block; }\n  else { cur = cur + '\\n\\n' + block; }\n}\nchunks.push(cur);\nconst fullHtml = (summary ? '<p><i>' + summary.replace(/</g, '&lt;') + '</i></p>' : '') + d.html;\nreturn chunks.map(t => ({ json: { text: t, fullHtml, count: d.count } }));"
      },

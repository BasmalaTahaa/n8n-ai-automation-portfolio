    {
      "parameters": {
        "jsCode": "const isReal = (j) => j && Object.keys(j).length > 0;\nconst rows = $input.all().map(i => i.json).filter(j => isReal(j) && j.row_number)\n  .filter(j => String(j.notified).trim().toUpperCase() !== 'TRUE');\nif (rows.length === 0) {\n  return [{ json: { count: 0 } }];\n}\nconst esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst groups = {};\nfor (const r of rows) {\n  const key = (r.sheet_name || '(unknown sheet)') + ' | ' + (r.editor_email || '(unknown editor)');\n  (groups[key] = groups[key] || []).push(r);\n}\nconst blocks = [];\nconst htmlBlocks = [];\nconst summaryLines = [];\nfor (const key of Object.keys(groups)) {\n  const list = groups[key];\n  const [sheet, editor] = key.split(' | ');\n  const lines = list.map(r => '- ' + r.cell + ': \"' + (r.old_value === undefined || r.old_value === '' ? '(empty)' : r.old_value) + '\" -> \"' + (r.new_value === undefined || r.new_value === '' ? '(empty)' : r.new_value) + '\"');\n  const link = list[0].file_url ? '\\n' + list[0].file_url : '';\n  blocks.push('Sheet: ' + sheet + '\\nEditor: ' + editor + ' (' + list.length + ' change(s))\\n' + lines.join('\\n') + link);\n  htmlBlocks.push('<h3>' + esc(sheet) + ' - ' + esc(editor) + ' (' + list.length + ')</h3><ul>' + list.map(r => '<li><b>' + esc(r.cell) + '</b>: ' + esc(r.old_value) + ' &rarr; ' + esc(r.new_value) + '</li>').join('') + '</ul>' + (list[0].file_url ? '<p><a href=\"' + esc(list[0].file_url) + '\">Open file</a></p>' : ''));\n  summaryLines.push(sheet + ' edited by ' + editor + ': ' + list.length + ' change(s) in cells ' + list.map(r => r.cell).join(', '));\n}\nreturn [{ json: {\n  count: rows.length,\n  rowNumbers: rows.map(r => r.row_number),\n  blocks,\n  html: htmlBlocks.join(''),\n  summaryInput: summaryLines.join('\\n'),\n} }];"
      },
